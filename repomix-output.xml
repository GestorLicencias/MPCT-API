    @Column(nullable = false)
    private EstadoTramite estado;

    @Lob
    @Basic(fetch = FetchType.LAZY)
    @Column(nullable = false)
    @com.fasterxml.jackson.annotation.JsonIgnore
    private byte[] archivoPlano;

    @Lob
    @Basic(fetch = FetchType.LAZY)
